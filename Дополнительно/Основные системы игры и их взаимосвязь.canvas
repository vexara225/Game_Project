{
	"nodes":[
		{"id":"cb1f81a89b7c3e89","type":"text","text":"Система управления персонажами","x":-340,"y":-360,"width":250,"height":60,"color":"6"},
		{"id":"15446acde436c527","type":"text","text":"системой столкновений - для проверки возможности перемещения","x":-340,"y":-220,"width":250,"height":90},
		{"id":"4f60e5798c7b69c6","type":"text","text":"системой переключения персонажей - для определения того, кем управляет игрок","x":-340,"y":-60,"width":250,"height":109},
		{"id":"2109c5a5c03ea424","type":"text","text":"системой работы с объектами - для выполнения взаимодействий","x":80,"y":-220,"width":250,"height":127},
		{"id":"074f7cb2d48d0096","type":"text","text":"системой Тени - при управлении Тенью","x":80,"y":-11,"width":250,"height":60},
		{"id":"e60c02893e4977a1","type":"text","text":"Ввод игрока → Управление персонажем → Столкновения / Взаимодействие","x":-321,"y":100,"width":651,"height":60,"color":"4"},
		{"id":"30ec6d008d82063a","type":"text","text":"Отвечает за обработку действий игрока и перемещение управляемого персонажа","x":80,"y":-760,"width":250,"height":120,"color":"5"},
		{"id":"b8267e375f655125","type":"text","text":"Движение объекта → Проверка столкновения → Разрешение или запрет перемещения","x":868,"y":44,"width":740,"height":50,"color":"4"},
		{"id":"a3372a54aa130e5d","type":"text","text":"системой управления персонажами","x":912,"y":-156,"width":250,"height":60},
		{"id":"45459c67f9da1e13","type":"text","text":"системой Тени","x":912,"y":-56,"width":250,"height":60},
		{"id":"2cb70483ccd8fc9d","type":"text","text":"системой противников","x":1313,"y":-216,"width":250,"height":60},
		{"id":"9cb77c16120c4771","type":"text","text":"системой исследования локаций","x":1313,"y":-116,"width":250,"height":60},
		{"id":"e9a34e4170fbfc65","type":"text","text":"Отвечает за обработку действий игрока и перемещение управляемого персонажа","x":571,"y":-611,"width":278,"height":109,"color":"5"},
		{"id":"5b40140c652709ba","type":"text","text":"Система столкновений","x":912,"y":-296,"width":250,"height":60,"color":"6"},
		{"id":"7959d0ef7185d973","type":"text","text":"системой работы с объектами","x":1313,"y":-296,"width":250,"height":60},
		{"id":"b270f2f7992d8c23","type":"text","text":"Персонаж → Объект → Проверка возможности взаимодействия → Изменение состояния объекта","x":1940,"y":-96,"width":833,"height":60,"color":"4"},
		{"id":"241d3e7819a72ded","type":"text","text":"системой столкновений","x":1980,"y":-196,"width":250,"height":60},
		{"id":"51677ec07f436cef","type":"text","text":"Например, взаимодействие с переключателем может открыть дверь или активировать механизм","x":2122,"y":44,"width":470,"height":77},
		{"id":"72a34ed5bc1cd554","type":"text","text":"Отвечает за взаимодействие персонажей с объектами игрового мира: дверями, переключателями, механизмами, предметами и элементами оборудования","x":2357,"y":-784,"width":375,"height":133,"color":"5"},
		{"id":"6f8eabdcdfea72c6","type":"text","text":"системой Тени","x":1980,"y":-676,"width":250,"height":60},
		{"id":"4848a51ca615dddc","type":"text","text":"Система работы с объектами","x":1980,"y":-456,"width":250,"height":60,"color":"6"},
		{"id":"01d184d5e27b8477","type":"text","text":"системой управления персонажами","x":1980,"y":-336,"width":250,"height":60},
		{"id":"e7a86813e38bc4f3","type":"text","text":"системой исследования локаций","x":2400,"y":-336,"width":250,"height":60},
		{"id":"3f5bb83b14c25946","type":"text","text":"системой головоломок","x":2420,"y":-451,"width":250,"height":50},
		{"id":"f3589b7a4add9f54","type":"text","text":"системой управления персонажами","x":3140,"y":-697,"width":250,"height":60},
		{"id":"4ca6e8b60dc8dc2a","type":"text","text":"системой работы с объектами","x":3140,"y":-337,"width":250,"height":60},
		{"id":"0f3fd917a9aef347","type":"text","text":"системой Тени","x":3140,"y":-177,"width":250,"height":60},
		{"id":"d74b56023d8ba1e0","type":"text","text":"Система головоломок","x":3142,"y":-497,"width":250,"height":60,"color":"6"},
		{"id":"1eecd91e43d90209","type":"text","text":"системой исследования локаций","x":3558,"y":-497,"width":250,"height":60},
		{"id":"35d2f1494318fcad","type":"text","text":"системой сохранения и загрузки","x":3580,"y":-337,"width":250,"height":60},
		{"id":"6f6e11f93f72fc1f","type":"text","text":"Действия игрока → Взаимодействие с объектами → Проверка условий → Решение головоломки → Изменение игрового мира","x":3066,"y":-57,"width":847,"height":60,"color":"4"},
		{"id":"1ecedf21e28568a1","type":"text","text":"Решение головоломки может открыть дверь, активировать механизм или предоставить доступ к новой области","x":3156,"y":83,"width":667,"height":60},
		{"id":"06a7ac5e6ea6a108","type":"text","text":"Отвечает за взаимодействие персонажей с объектами игрового мира: дверями, переключателями, механизмами, предметами и элементами оборудования","x":3561,"y":-907,"width":352,"height":127,"color":"5"},
		{"id":"ceb22835aca50d8d","type":"text","text":"Отвечает за существование, перемещение и особенности Тени как отдельного управляемого объекта","x":4879,"y":-840,"width":301,"height":106,"color":"5"},
		{"id":"665a7640a7fce92b","type":"text","text":"системой управления персонажами","x":4400,"y":-309,"width":250,"height":60},
		{"id":"50e9cb8791da4f1e","type":"text","text":"системой головоломок","x":4930,"y":-309,"width":250,"height":60},
		{"id":"7a6ac465839be5d9","type":"text","text":"системой переключения персонажей","x":4400,"y":-169,"width":250,"height":60},
		{"id":"53368cbedd7a74b8","type":"text","text":"системой исследования локаций","x":4930,"y":-169,"width":250,"height":60},
		{"id":"a6b8c25e11e06223","type":"text","text":"Переключение → Управление Тенью → Проверка ограничений → Перемещение / Взаимодействие","x":4470,"y":-29,"width":664,"height":60,"color":"4"},
		{"id":"2e735856f92229a5","type":"text","text":"Система также контролирует ограничение расстояния между Тенью и главным героем","x":4535,"y":91,"width":534,"height":60},
		{"id":"c772083f51ff376f","type":"text","text":"системой столкновений","x":4400,"y":-669,"width":250,"height":60},
		{"id":"b91ffbed2a190b1e","type":"text","text":"Система Тени","x":4400,"y":-462,"width":250,"height":60,"color":"6"},
		{"id":"0f79ff08c3e7b6a7","type":"text","text":"системой работы с объектами","x":4930,"y":-462,"width":250,"height":60},
		{"id":"b8eea24eeaf38fb1","type":"text","text":"Система переключения персонажей","x":5600,"y":-363,"width":250,"height":60,"color":"6"},
		{"id":"0f3f9d9ddae7236a","type":"text","text":"системой управления персонажами","x":5600,"y":-237,"width":250,"height":60},
		{"id":"6bdda026e9bfbac3","type":"text","text":"системой Тени","x":5600,"y":-117,"width":250,"height":60},
		{"id":"2431032b6b432eb9","type":"text","text":"Нажатие кнопки → Проверка возможности переключения → Передача управления","x":5647,"y":-37,"width":722,"height":50,"color":"4"},
		{"id":"cc7de671cea955b4","type":"text","text":"При переключении один персонаж становится управляемым, а второй продолжает находиться в игровом мире","x":5678,"y":83,"width":661,"height":60},
		{"id":"3de32dcf732f67a6","type":"text","text":"системой головоломок","x":6008,"y":-363,"width":250,"height":60},
		{"id":"213732abcb87bfb5","type":"text","text":"Отвечает за передачу управления между главным героем и Тенью","x":5600,"y":-678,"width":252,"height":101,"color":"5"},
		{"id":"86486fdef02acf32","type":"text","text":"системой исследования локаций","x":114,"y":898,"width":250,"height":60},
		{"id":"238d901ac6eb7a6b","type":"text","text":"системой поражения игрока","x":114,"y":1008,"width":250,"height":60},
		{"id":"46420087fe121bdf","type":"text","text":"системой сохранения и загрузки","x":114,"y":1138,"width":250,"height":60},
		{"id":"d8cebab856396e6b","type":"text","text":"Поведение противника → Обнаружение игрока → Преследование / другая реакция → Проверка результата","x":-287,"y":1318,"width":598,"height":80,"color":"4"},
		{"id":"7019eefe02505900","type":"text","text":"Противник может находиться в состоянии обычного перемещения, обнаружения игрока, преследования или возвращения к обычному поведению","x":-282,"y":1478,"width":593,"height":81},
		{"id":"7b5d3d1f7caf7a5a","type":"text","text":"Система противников","x":-360,"y":898,"width":250,"height":60,"color":"6"},
		{"id":"ca9793cb584f4fba","type":"text","text":"системой управления персонажами","x":-360,"y":1038,"width":250,"height":60},
		{"id":"ae6de2a1b5f281ee","type":"text","text":"системой столкновений","x":-360,"y":1198,"width":250,"height":60},
		{"id":"85186f00523af426","type":"text","text":"системой сохранения и загрузки","x":1490,"y":898,"width":250,"height":60},
		{"id":"46584e65e0c9b8d9","type":"text","text":"системой головоломок","x":1490,"y":1057,"width":250,"height":50},
		{"id":"7d32bc7776903558","type":"text","text":"системой противников","x":1490,"y":1187,"width":250,"height":60},
		{"id":"74528121d6a58735","type":"text","text":"системой управления персонажами","x":988,"y":1047,"width":250,"height":60},
		{"id":"b2bfc9434aa17e74","type":"text","text":"системой столкновений","x":988,"y":1187,"width":250,"height":60},
		{"id":"9066fd4692c6491f","type":"text","text":"Перемещение → Исследование → Взаимодействие / решение головоломки → Открытие новой области","x":1043,"y":1327,"width":697,"height":60,"color":"4"},
		{"id":"a90b2ee04673b145","type":"text","text":"системой работы с объектами","x":988,"y":747,"width":250,"height":60},
		{"id":"3bf0c87ff0f1d15d","type":"text","text":"Система исследования локаций","x":988,"y":898,"width":250,"height":60,"color":"6"},
		{"id":"56eed298b426feec","type":"text","text":"Отвечает за поведение мутировавших учёных, их перемещение и реакцию на игрока","x":-360,"y":500,"width":266,"height":107,"color":"5"},
		{"id":"cf7360e111bbded6","type":"text","text":"Отвечает за перемещение игрока между областями научного центра и доступность различных частей игрового мира","x":566,"y":484,"width":302,"height":140,"color":"5"},
		{"id":"455d8ea0a24fd81e","type":"text","text":"Система сохранения и загрузки","x":2201,"y":987,"width":250,"height":60,"color":"6"},
		{"id":"c6cd93057e7ccb5d","type":"text","text":"системой Тени","x":2650,"y":987,"width":250,"height":60},
		{"id":"9f120858ee904cda","type":"text","text":"системой исследования локаций","x":2201,"y":1113,"width":250,"height":60},
		{"id":"62302b23a9a21fe4","type":"text","text":"системой противников","x":2650,"y":1127,"width":250,"height":60},
		{"id":"9adf007c7d8f687b","type":"text","text":"системой головоломок","x":2201,"y":1253,"width":250,"height":60},
		{"id":"39e8525ebb58bc67","type":"text","text":"Игровые системы → Состояние игры → Файл сохранения → Загрузка → Восстановление состояния","x":2288,"y":1378,"width":612,"height":50,"color":"4"},
		{"id":"49a37f37499a9f1b","type":"text","text":"системой управления персонажами","x":2201,"y":753,"width":250,"height":60},
		{"id":"b00e49200b7a313f","type":"text","text":"Отвечает за перемещение игрока между областями научного центра и доступность различных частей игрового мира","x":2514,"y":606,"width":261,"height":141,"color":"5"},
		{"id":"2ee69b9f217a84ae","type":"text","text":"системой работы с объектами","x":3244,"y":1208,"width":250,"height":60},
		{"id":"38d44dc4bd610643","type":"text","text":"<mark style=\"background:rgba(160, 204, 246, 0.55)\">Например,</mark> при взаимодействии с объектом система работы с объектами передаёт событие системе звука, после чего воспроизводится соответствующий звуковой эффект","x":3580,"y":1308,"width":367,"height":140},
		{"id":"4608fdf761c04c01","type":"text","text":"системой противников","x":3244,"y":848,"width":250,"height":60},
