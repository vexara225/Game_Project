		{"id":"d7b5b64b2ac4b4d9","type":"text","text":"системой управления персонажами","x":3244,"y":1088,"width":250,"height":60},
		{"id":"ae4d34261d1c056d","type":"text","text":"Отвечает за воспроизведение музыки, фоновых звуков, звуков взаимодействия и звуков противников","x":3609,"y":588,"width":361,"height":96,"color":"5"},
		{"id":"4df8d8f0a49dc362","type":"text","text":"системой исследования локаций","x":3720,"y":968,"width":250,"height":60},
		{"id":"2cc5d5c095fb5f97","type":"text","text":"системой пользовательского интерфейса","x":3720,"y":1088,"width":250,"height":82},
		{"id":"591ac334557bdf4d","type":"text","text":"системой сохранения и загрузки","x":4509,"y":787,"width":250,"height":60},
		{"id":"eda84736b44ab5a9","type":"text","text":"Система пользовательского интерфейса","x":4509,"y":984,"width":250,"height":83,"color":"6"},
		{"id":"153a44974bf00803","type":"text","text":"Отвечает за отображение меню, подсказок, сообщений и другой необходимой информации","x":4879,"y":676,"width":275,"height":111,"color":"5"},
