{
	"nodes":[
		{"id":"520b8bd480aa58f8","type":"text","text":"<center>ТЕНЬ</center>","x":-186,"y":13,"width":250,"height":60,"color":"5"},
		{"id":"6c9165c14fae071a","type":"text","text":"<center>ПЕРСОНАЖ</center>","x":-186,"y":-139,"width":250,"height":60,"color":"4"},
		{"id":"7ae5ea22f6183e92","type":"text","text":"<center>Хотяба</center>","x":-186,"y":-357,"width":250,"height":60},
		{"id":"91406fa1155c3418","type":"text","text":"Движение в 4 направлениях:\n\n1. Вверх\n2. Вниз\n3. Влево\n4. Вправо","x":-791,"y":-861,"width":250,"height":214},
		{"id":"8cd3f037523a3818","type":"text","text":"Можно сделать движение по диагонали, если одновременно нажать две клавиши","x":-111,"y":-1457,"width":250,"height":81},
		{"id":"032670b44a520001","type":"text","text":"Скорость постоянная, без сложной физики","x":14,"y":-577,"width":250,"height":60},
		{"id":"b914980e30aed6b6","type":"text","text":"Ходит","x":-541,"y":483,"width":250,"height":60},
		{"id":"5e0185488415092a","type":"text","text":"Сталкивается с определёнными препядствиями","x":-236,"y":603,"width":250,"height":87},
		{"id":"1f58357dd46be835","type":"file","file":"мывювмы/Everything for documentation/Characters/Тень/Тексовое описание механник/Определённые препятствия.md","x":-311,"y":823,"width":400,"height":560},
		{"id":"ff4027ffd516e4b4","type":"text","text":"Взаимодействует с определёнными объектами","x":139,"y":285,"width":250,"height":79},
		{"id":"79adfaa5a2ea0d5d","type":"text","text":"Во-первых, тень может видеть скрытые символы или порталы, которые недоступны персонажу","x":139,"y":425,"width":250,"height":116},
		{"id":"f5c4b88703ab3d6c","type":"text","text":"Во-вторых, тень может активировать  специальные механизмы, например открывать двери, когда она в определённой позиции","x":139,"y":622,"width":250,"height":161},
		{"id":"293d0e3f355642c5","type":"file","file":"мывювмы/Теневые фрагменты.md","x":564,"y":1027,"width":400,"height":327},
		{"id":"37fbbeb30e3c562a","type":"text","text":"Имеет ограничение по расстоянию от персонажа","x":514,"y":225,"width":250,"height":60},
		{"id":"8bb2b53f27f9b1e9","type":"text","text":"<center>Прочее</center>","x":389,"y":-267,"width":250,"height":60},
		{"id":"8655e5429f025c6d","type":"text","text":"Персонаж не может проходить сквозь стены, оборудование и другие препятствия","x":179,"y":-1027,"width":250,"height":110},
		{"id":"8e7db16788ff10da","type":"text","text":"При столкновении с объектом персонаж останавливается","x":714,"y":-861,"width":250,"height":76},
		{"id":"e95f2247acdd1618","type":"text","text":"В-третьих, тень может собирать теневые фрагменты","x":139,"y":900,"width":250,"height":84}
	],
